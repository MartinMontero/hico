{
  // Top level is the PREVIEW Worker. The "prod" environment is hico-prod.
  // Never use the names hico, mec-trails, lume or lume-city (live apps): tests/node/names.test.ts.
  // database_id values are zero placeholders: only local D1 is used until a GO for `d1 create`.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hico-preview",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-07",
  "observability": { "enabled": true },
  // The daily retention purge (06 §2), 03:17 UTC. Declared for each environment: triggers are not inherited.
  "triggers": { "crons": ["17 3 * * *"] },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": true
  },
  // RP_ID and ALLOWED_ORIGINS are the WebAuthn relying party for LOCAL use (vite dev 5173, vite preview 4173).
  // A passkey is bound to its RP_ID: before a deploy these must be set to the real hostname (a GO), and the prod
  // environment sets neither, so staff sign-in answers 503 there until they are set on purpose.
  "vars": { "PREVIEW_GATE": "on", "RP_ID": "localhost", "ALLOWED_ORIGINS": "http://localhost:5173,http://localhost:4173" },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hico-preview",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "env": {
    "prod": {
      "name": "hico-prod",
      "triggers": { "crons": ["17 3 * * *"] },
      "assets": {
        "binding": "ASSETS",
        "not_found_handling": "single-page-application",
        "run_worker_first": true
      },
      "vars": { "PREVIEW_GATE": "off" },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "hico-prod",
          "database_id": "00000000-0000-0000-0000-000000000000",
          "migrations_dir": "migrations"
        }
      ]
    }
  }
}
